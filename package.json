    "@types/webpack-bundle-analyzer": "^4.7.0",
    "@types/webpack-dev-server": "^4.7.2",
    "@typescript-eslint/eslint-plugin": "^5.12.1",
    "@typescript-eslint/parser": "^5.62.0",
    "babel-jest": "^29.7.0",
    "circular-dependency-plugin": "^5.2.2",
    "concurrently": "^9.1.2",
